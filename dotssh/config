Host *
 IdentitiesOnly yes
 AddKeysToAgent yes
 StrictHostKeyChecking no

Host aws-ssm
  HostName $EC2_INSTANCE_PREPROD #ec2 instance id
  User appadmins
  # RequestTTY force
  ProxyCommand sh -c "aws ssm start-session --target %h --document-name AWS-StartSSHSession --parameters 'portNumber=22' --region ap-southeast-3"
  IdentityFile $HOME/.ssh/id_rsa_bastion
  ForkAfterAuthentication yes
  SessionType none
  LocalForward 1220 localhost:22
  LocalForward 1221 10.54.129.92:22
  DynamicForward 8443
  ServerAliveInterval 60
  ServerAliveCountMax 3


Host mea-preprod
  HostName 10.54.129.92
  ProxyCommand sh -c "nc -X 5 -x localhost:8443 %h %p"
  UserKnownHostsFile=/dev/null
  StrictHostKeyChecking no
  User apps
  IdentityFile $HOME/.ssh/id_rsa_bastion

